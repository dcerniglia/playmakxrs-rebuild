---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contact Us - Playmakxrs Global™"
  description="Start a conversation with Playmakxrs™. We welcome thoughtful inquiries from institutions, educators, and partners."
>
  <Navigation />

  <Hero
    title="Start a Conversation"
    subtitle="Clarity First. Alignment First."
    description="Scale only where trust supports it. If your institution or organization believes that real stories still carry long-term value, we welcome the conversation."
  />

  <!-- Framing -->
  <section class="section bg-white">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <p class="text-xl lg:text-2xl text-gray-600 leading-relaxed">
        If you are seeking a disciplined way to preserve legacy, strengthen identity, and steward Narrative Capital™ responsibly, Playmakxrs™ may be a fit. We work selectively and begin with alignment, not pressure.
      </p>
    </div>
  </section>

  <Contact />

  <Footer />
</Layout>
