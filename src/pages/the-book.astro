---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;
const buildPath = (path: string) => `${base}/${path}`.replace(/\/+/g, '/');
const amazonUrl = 'https://www.amazon.com/No-Grier-Game-Showdown-American/dp/196937246X/ref=tmm_hrd_swatch_0';
const barnesNobleUrl = 'https://www.barnesandnoble.com/w/no-grier-no-game-rob-grier/1148515839';
---

<Layout
  title="No Grier, No Game - Playmakxrs Global™"
  description="How Bobby Grier and the Sugar Bowl Showdown Changed American Sports History"
>
  <Navigation />

  <!-- Quote Block -->
  <section class="bg-gray-50 py-10">
    <div class="max-w-3xl mx-auto px-6">
      <blockquote class="text-center">
        <p class="text-lg md:text-xl text-gray-700 leading-relaxed italic mb-4">
          "The story of Bobby Grier is not just about football. It is about a man whose strength and dignity challenged a nation to live up to its ideals. His legacy reminds us that one act of courage, carried out with perseverance and grace, can ripple across generations."
        </p>
        <cite class="text-sm text-gray-500 not-italic">
          — <strong>Steve Schwab</strong>, CEO, Elizabeth Dole Foundation
        </cite>
      </blockquote>
    </div>
  </section>

  <!-- Hero Section with Book Cover -->
  <section class="bg-black text-white py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <div class="flex justify-center lg:justify-end">
          <div class="relative max-w-sm">
            <img
              src={buildPath('book-cover.png')}
              alt="No Grier, No Game book cover"
              class="rounded-lg shadow-2xl w-full"
              loading="eager"
            />
            <div class="absolute -bottom-4 -right-4 bg-yellow-400 text-black px-5 py-2 rounded-full font-display font-bold text-sm shadow-xl transform rotate-3 border-3 border-black">
              Available Now
            </div>
          </div>
        </div>

        <div class="text-center lg:text-left">
          <h1 class="font-display text-4xl md:text-5xl font-black mb-3 leading-tight">
            No Grier, <span class="text-primary">No Game</span>
          </h1>
          <h2 class="text-lg md:text-xl mb-6 opacity-90">
            How Bobby Grier and the Sugar Bowl Showdown Changed American Sports History
          </h2>
          <Button text="Order the Book" href={amazonUrl} variant="primary" />
        </div>
      </div>
    </div>
  </section>

  <!-- Book Description -->
  <section class="section bg-white">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-4 text-center">
        A Story of Character
      </h2>
      <div class="space-y-4 text-gray-700 leading-relaxed">
        <p>
          In 1956, Bobby Grier's quiet courage helped change college football and American sports during the Sugar Bowl. His presence on that field was not performative or theatrical — it was an act of dignity, restraint, and resolve.
        </p>
        <p>
          <em>No Grier, No Game</em> tells that story with the same care and historical integrity it deserves. This is not a story of spectacle. It is a story of character — written to preserve, not to promote.
        </p>
      </div>
    </div>
  </section>

  <!-- Why This Story Endures -->
  <section class="section bg-gray-50">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-4 text-center">
        Why This Story Endures
      </h2>
      <p class="text-lg text-gray-500 mb-8 text-center max-w-2xl mx-auto">
        Bobby Grier’s legacy reflects values that remain institutionally relevant today.
      </p>
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-3">
        <div class="value-pill text-sm">Courage under pressure</div>
        <div class="value-pill text-sm">Leadership without bravado</div>
        <div class="value-pill text-sm">Progress through dignity</div>
        <div class="value-pill text-sm">Team unity</div>
        <div class="value-pill text-sm">Belonging</div>
        <div class="value-pill text-sm">Institutional courage</div>
      </div>
      <p class="text-lg text-gray-500 leading-relaxed text-center mt-6 max-w-2xl mx-auto">
        These are not temporary themes. They remain meaningful across athletics, education, civic life, and leadership development.
      </p>
    </div>
  </section>

  <!-- Part of a Larger Platform -->
  <section class="section bg-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-4">
        Part of a Larger Platform
      </h2>
      <p class="text-xl lg:text-2xl text-gray-700 leading-relaxed mb-4">
        The book stands on its own as meaningful nonfiction, but it also anchors a broader institutional model. The Bobby Grier Story™ demonstrates how one consequential story can become a narrative cluster — book, archive, education, athletics, alumni, digital exhibit, sponsor alignment, leadership programming, media development, and civil-society dialogue.
      </p>
      <p class="text-lg text-gray-500 italic">
        The purpose is not to overextend the story. It is to ensure its meaning remains durable, accessible, and responsibly activated.
      </p>
    </div>
  </section>

  <!-- Where to Find the Book -->
  <section class="section bg-gray-50">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-4">
        Where to Find the Book
      </h2>
      <p class="text-xl lg:text-2xl text-gray-700 leading-relaxed mb-6">
        Available in hardcover through Amazon and Barnes & Noble, as well as through university programs and institutional events.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <Button text="Amazon" href={amazonUrl} variant="primary" />
        <Button text="Barnes & Noble" href={barnesNobleUrl} variant="secondary" />
      </div>
    </div>
  </section>

  <!-- For Readers, Educators, and Institutions -->
  <section class="section bg-white">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-4">
        For Readers, Educators, and Institutions
      </h2>
      <p class="text-xl lg:text-2xl text-gray-700 leading-relaxed">
        <em>No Grier, No Game</em> has been embraced by readers seeking meaningful nonfiction, educators bringing authentic history into the classroom, alumni and athletic communities honoring legacy, and institutions committed to preserving stories that endure.
      </p>
    </div>
  </section>

  <!-- Why This Matters Now -->
  <section class="section bg-gray-50">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-4">
        Why This Matters Now
      </h2>
      <p class="text-xl lg:text-2xl text-gray-700 leading-relaxed">
        Audiences are turning away from manufactured narratives. Institutions are seeking meaning. This is storytelling for endurance — not attention.
      </p>
    </div>
  </section>

  <!-- An Invitation -->
  <section class="section bg-black text-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold mb-3">
        An Invitation
      </h2>
      <p class="text-xl lg:text-2xl opacity-90 mb-6 leading-relaxed">
        We partner selectively with institutions and organizations that value integrity, legacy, and long-term impact.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <Button text="Find the Book" href={amazonUrl} variant="primary" />
        <Button text="Start a Conversation" href={buildPath('contact-us')} variant="secondary" />
      </div>
    </div>
  </section>

  <Footer />
</Layout>
