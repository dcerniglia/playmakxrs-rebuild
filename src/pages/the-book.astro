---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;
const buildPath = (path: string) => `${base}/${path}`.replace(/\/+/g, '/');
const amazonUrl = 'https://www.amazon.com/No-Grier-Game-Showdown-American/dp/196937246X/ref=tmm_hrd_swatch_0';
const barnesNobleUrl = 'https://www.barnesandnoble.com/w/no-grier-no-game-rob-grier/1148515839';
---

<Layout
  title="No Grier, No Game - Playmakxrs Global™"
  description="How Bobby Grier and the Sugar Bowl Showdown Changed American Sports History"
>
  <Navigation />

  <!-- Quote Block -->
  <section class="bg-gray-50 py-16">
    <div class="max-w-4xl mx-auto px-6">
      <blockquote class="text-center">
        <p class="text-xl md:text-2xl text-gray-700 leading-relaxed italic mb-6">
          "The story of Bobby Grier is not just about football. It is about a man whose strength and dignity challenged a nation to live up to its ideals. His legacy reminds us that one act of courage, carried out with perseverance and grace, can ripple across generations."
        </p>
        <cite class="text-lg text-gray-600 not-italic">
          — <strong>Steve Schwab</strong>, CEO, Elizabeth Dole Foundation
        </cite>
      </blockquote>
    </div>
  </section>

  <!-- Hero Section with Book Cover -->
  <section class="bg-black text-white py-20 lg:py-32">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Book Cover Image -->
        <div class="flex justify-center lg:justify-end">
          <div class="relative max-w-md">
            <img
              src={buildPath('book-cover.png')}
              alt="No Grier, No Game book cover"
              class="rounded-lg shadow-2xl w-full"
              loading="eager"
            />
            <div class="absolute -bottom-6 -right-6 bg-yellow-400 text-black px-6 py-3 rounded-full font-display font-bold shadow-xl transform rotate-3 border-4 border-black">
              Available Now
            </div>
          </div>
        </div>

        <!-- Book Info -->
        <div class="text-center lg:text-left">
          <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-black mb-4 leading-tight">
            No Grier, <span class="text-primary">No Game</span>
          </h1>
          <h2 class="text-xl md:text-2xl mb-8 opacity-90">
            How Bobby Grier and the Sugar Bowl Showdown Changed American Sports History
          </h2>
          <Button text="Order the Book" href={amazonUrl} variant="primary" />
        </div>
      </div>
    </div>
  </section>

  <!-- Book Description -->
  <section class="bg-white py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-black mb-8 text-center">
        A Story of Character
      </h2>
      <div class="space-y-6 text-lg text-gray-700 leading-relaxed">
        <p>
          In 1956, Bobby Grier's quiet courage helped change college football and American sports during the Sugar Bowl. His presence on that field was not performative or theatrical — it was an act of dignity, restraint, and resolve.
        </p>
        <p>
          <em>No Grier, No Game</em> tells that story with the same care and historical integrity it deserves. This is not a story of spectacle. It is a story of character — written to preserve, not to promote.
        </p>
      </div>
    </div>
  </section>

  <!-- Why This Story Matters -->
  <section class="bg-gray-50 py-20">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-black mb-12 text-center">
        Why This Story Matters
      </h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center">
          <h3 class="font-display text-lg font-bold text-black mb-3">Courage under pressure</h3>
        </div>
        <div class="text-center">
          <h3 class="font-display text-lg font-bold text-black mb-3">Leadership without bravado</h3>
        </div>
        <div class="text-center">
          <h3 class="font-display text-lg font-bold text-black mb-3">Progress achieved through dignity</h3>
        </div>
        <div class="text-center">
          <h3 class="font-display text-lg font-bold text-black mb-3">The power of sport to reflect our highest ideals</h3>
        </div>
      </div>
    </div>
  </section>

  <!-- Part of a Larger Legacy -->
  <section class="bg-white py-20">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-black mb-6">
        Part of a Larger Legacy
      </h2>
      <p class="text-xl text-gray-700 leading-relaxed">
        This book is the foundation of The Bobby Grier Story™, stewarded by Playmakxrs™. It anchors educational, institutional, and cultural initiatives that carry the story forward with integrity.
      </p>
    </div>
  </section>

  <!-- Where to Find the Book -->
  <section class="bg-gray-50 py-20">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-black mb-6">
        Where to Find the Book
      </h2>
      <p class="text-lg text-gray-700 leading-relaxed mb-8">
        Available in hardcover through Amazon and Barnes & Noble, as well as through university programs and institutional events.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button text="Amazon" href={amazonUrl} variant="primary" />
        <Button text="Barnes & Noble" href={barnesNobleUrl} variant="secondary" />
      </div>
    </div>
  </section>

  <!-- For Readers, Educators, and Institutions -->
  <section class="bg-white py-20">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-black mb-6">
        For Readers, Educators, and Institutions
      </h2>
      <p class="text-xl text-gray-700 leading-relaxed">
        <em>No Grier, No Game</em> has been embraced by readers seeking meaningful nonfiction, educators bringing authentic history into the classroom, alumni and athletic communities honoring legacy, and institutions committed to preserving stories that endure.
      </p>
    </div>
  </section>

  <!-- Why This Matters Now -->
  <section class="bg-gray-50 py-20">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-black mb-6">
        Why This Matters Now
      </h2>
      <p class="text-xl text-gray-700 leading-relaxed">
        Audiences are turning away from manufactured narratives. Institutions are seeking meaning. This is storytelling for endurance — not attention.
      </p>
    </div>
  </section>

  <!-- An Invitation -->
  <section class="bg-black text-white py-20">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-4xl md:text-5xl font-bold mb-6">
        An Invitation
      </h2>
      <p class="text-xl opacity-90 mb-8 leading-relaxed">
        Become a Playmakxr™
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button text="Start a Conversation" href={buildPath('partnership')} variant="primary" />
        <Button text="Follow the Legacy" href={buildPath('contact-us')} variant="secondary" />
      </div>
    </div>
  </section>

  <Footer />
</Layout>
