---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;
const buildPath = (path: string) => `${base}/${path}`.replace(/\/+/g, '/');
const shopifyUrl = 'https://playmakxrs.myshopify.com';
---

<Layout
  title="Merchandise - Playmakxrs Global™"
  description="The Playmakxrs™ Collection exists for those who wish to carry the story forward in a tangible way."
>
  <Navigation />

  <Hero
    title="The Collection"
    subtitle="A Way to Participate"
    description="The Playmakxrs™ Collection exists for those who wish to carry the story forward in a tangible way. Each piece is designed with the same care and restraint that guides our storytelling."
    ctaText="View the Collection"
    ctaHref={shopifyUrl}
  />

  <!-- Why It Exists -->
  <section class="section bg-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-4">
        Why It Exists
      </h2>
      <p class="text-xl lg:text-2xl text-gray-700 leading-relaxed mb-3">
        For some, engaging with the story through reading or conversation is enough. For others, wearing or sharing a piece becomes a way to remain connected over time.
      </p>
      <p class="text-lg text-gray-500 leading-relaxed">
        The collection is a physical extension of The Bobby Grier Story™ — built with no spectacle, no trend, and no excess.
      </p>
    </div>
  </section>

  <!-- What Guides the Collection -->
  <section class="section bg-gray-50">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-8 text-center">
        What Guides the Collection
      </h2>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="value-pill">Purpose over volume</div>
        <div class="value-pill">Simplicity over statement</div>
        <div class="value-pill">Quality over novelty</div>
        <div class="value-pill">Meaning over messaging</div>
      </div>
      <p class="text-lg text-gray-500 leading-relaxed text-center mt-6">
        Each item is produced in limited runs and designed to endure.
      </p>
    </div>
  </section>

  <!-- A Note on Proceeds -->
  <section class="section bg-white">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-4">
        A Note on Proceeds
      </h2>
      <p class="text-xl lg:text-2xl text-gray-700 leading-relaxed">
        Proceeds support the continued preservation and stewardship of authentic American legacy stories. This is participation, not promotion.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-black text-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold mb-4">
        Explore the Collection
      </h2>
      <p class="text-xl lg:text-2xl opacity-90 mb-6 leading-relaxed">
        No urgency. No pressure. Only intention.
      </p>
      <Button text="View the Collection" href={shopifyUrl} variant="primary" />
    </div>
  </section>

  <Footer />
</Layout>
