---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Updates - Playmakxrs Global™"
  description="Moments, milestones, and ongoing work stewarded by Playmakxrs™."
>
  <Navigation />

  <Hero
    title="Updates"
    subtitle="Moments, Milestones, and Ongoing Work"
    description="A living record of the work stewarded by Playmakxrs™. These are markers of continuity, not designed for attention."
  />

  <!-- Content Types -->
  <section class="bg-white py-20">
    <div class="max-w-4xl mx-auto px-6">
      <ul class="dash-list">
        <li>National moments and recognitions</li>
        <li>University and institutional collaborations</li>
        <li>Book-related milestones and events</li>
        <li>Community conversations and campus engagements</li>
        <li>Behind-the-scenes progress</li>
      </ul>
      <p class="text-lg text-gray-600 leading-relaxed text-center mt-12 italic">
        Published deliberately, not continuously.
      </p>
    </div>
  </section>

  <!-- Placeholder for future posts -->
  <section class="bg-gray-50 py-20">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="text-xl text-gray-500">
        Updates coming soon.
      </p>
    </div>
  </section>

  <Footer />
</Layout>
