---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;
const buildPath = (path: string) => `${base}/${path}`.replace(/\/+/g, '/');
---

<Layout
  title="About Us - Playmakxrs Global™"
  description="A narrative stewardship platform dedicated to preserving and elevating authentic American legacy stories"
>
  <Navigation />

  <Hero
    title="Who We Are"
    description="Playmakxrs™ and Playmakxrs Global™ are a narrative stewardship platform dedicated to preserving and elevating authentic American legacy stories."
  />

  <!-- Mission Statement -->
  <section class="bg-white py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-black mb-6 text-center">
        Our Mission
      </h2>
      <p class="text-xl text-gray-700 leading-relaxed text-center mb-8">
        We work at the intersection of history, sport, education, and culture — alongside universities, institutions, and foundations committed to preserving stories that carry meaning.
      </p>
      <p class="text-lg text-gray-600 leading-relaxed text-center">
        Our role is simple and deliberate: to ensure that important stories endure.
      </p>
    </div>
  </section>

  <!-- Our Belief -->
  <section class="bg-gray-50 py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-black mb-6 text-center">
        Our Belief
      </h2>
      <p class="text-xl text-gray-700 leading-relaxed text-center">
        Real stories matter because they shape identity, values, and collective memory. When handled with care, they unify communities and strengthen institutions.
      </p>
    </div>
  </section>

  <!-- Our History -->
  <section class="bg-white py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-black mb-6 text-center">
        Our History
      </h2>
      <div class="space-y-6 text-lg text-gray-700 leading-relaxed text-center">
        <p>
          Our foundation is The Bobby Grier Story™ — a true account of quiet courage, dignity, and resolve during the 1956 Sugar Bowl. Bobby Grier's story is not mythology. It is authentic factual history.
        </p>
        <p>
          That story became the Amazon bestselling book <em>No Grier, No Game™</em>, and continues to anchor everything we do.
        </p>
      </div>
    </div>
  </section>

  <!-- How We Work -->
  <section class="bg-gray-50 py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-black mb-6 text-center">
        How We Work
      </h2>
      <p class="text-xl text-gray-700 leading-relaxed text-center mb-8">
        Our governing principle is coherence before scale.
      </p>
      <div class="max-w-2xl mx-auto">
        <ul class="space-y-4 text-lg text-gray-700">
          <li class="flex items-start gap-3">
            <span class="text-primary mt-1 font-bold">—</span>
            <span>Trust precedes growth</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-primary mt-1 font-bold">—</span>
            <span>Meaning precedes momentum</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-primary mt-1 font-bold">—</span>
            <span>Alignment precedes amplification</span>
          </li>
        </ul>
        <p class="text-lg text-gray-600 leading-relaxed mt-8 text-center">
          We choose restraint over noise, clarity over spectacle, and durability over trend.
        </p>
      </div>
    </div>
  </section>

  <!-- Our Role in Culture -->
  <section class="bg-white py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-black mb-6 text-center">
        Our Role in Culture
      </h2>
      <p class="text-xl text-gray-700 leading-relaxed text-center mb-6">
        We offer a principled alternative to spectacle-driven storytelling.
      </p>
      <p class="text-lg text-gray-600 leading-relaxed text-center">
        We teach without preaching, inspire without exaggeration, and unite without erasing difference. What we build is cultural continuity, not nostalgia.
      </p>
    </div>
  </section>

  <!-- Looking Forward -->
  <section class="bg-black text-white py-20">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-4xl md:text-5xl font-bold mb-6">
        Looking Forward
      </h2>
      <p class="text-xl opacity-90 leading-relaxed">
        From Times Square moments to campus conversations, we take the long view. We are not interested in rushing culture. We are interested in continuity, not acceleration.
      </p>
    </div>
  </section>

  <Footer />
</Layout>
