---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import ProofLoop from '../components/ProofLoop.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;
const buildPath = (path: string) => `${base}/${path}`.replace(/\/+/g, '/');

const notList = [
  'A PR campaign',
  'A viral content shop',
  'A political reaction engine',
  'An AI content factory',
  'A traditional agency',
  'A production-only company',
  'A short-term visibility play',
];
---

<Layout
  title="About — Playmakxrs Global™"
  description="Playmakxrs™ is an Institutional Narrative Infrastructure™ platform built to help institutions identify, protect, verify, govern, and activate Narrative Capital™."
>
  <Navigation />

  <Hero
    title="About Playmakxrs™"
    subtitle="Infrastructure for Meaning That Endures"
    description="Playmakxrs™ and Playmakxrs Global™ are an Institutional Narrative Infrastructure™ platform built to help institutions identify, protect, verify, govern, and activate Narrative Capital™ — at the intersection of history, athletics, education, culture, sponsorship, media, and institutional identity."
  />

  <!-- What We Believe -->
  <section class="section bg-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-4">
        What We Believe
      </h2>
      <p class="text-xl lg:text-2xl text-gray-700 leading-relaxed mb-4">
        Not every story should be optimized for attention. Some should be governed with restraint — because they shape identity, trust, belonging, and public memory over time.
      </p>
      <p class="text-lg text-gray-500 leading-relaxed max-w-2xl mx-auto">
        Handled with care, these stories strengthen the institutions that carry them forward. Handled poorly, they fragment, dilute, or disconnect from the values they represent. Playmakxrs™ was built to protect against that loss of coherence.
      </p>
    </div>
  </section>

  <!-- Origin Story -->
  <section class="section bg-gray-50">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-4">
        Playmakxrs’™ Origin Story™
      </h2>
      <p class="text-xl lg:text-2xl text-gray-700 leading-relaxed mb-4">
        The Bobby Grier Story™ is the foundational narrative within Playmakxrs™. Through <em>No Grier, No Game™</em>, a historically documented moment of courage, dignity, and institutional consequence in American sports has been preserved with care.
      </p>
      <p class="text-lg text-gray-500 leading-relaxed max-w-2xl mx-auto">
        More importantly, it provides a model for how significant stories can be stewarded beyond a book, broadcast, or commemorative moment — how Narrative Capital™ can be structured, protected, and extended responsibly. That model informs how Playmakxrs™ approaches every future narrative cluster.
      </p>
    </div>
  </section>

  <!-- Proof Loop -->
  <section class="section bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-3">
          One Story, Many Assets
        </h2>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">
          The same verified story, compounding across media, archives, athletics, and publishing — the proof loop behind the model.
        </p>
      </div>
      <ProofLoop />
      <div class="text-center mt-10">
        <Button text="Read No Grier, No Game™" href={buildPath('the-book')} variant="primary" />
      </div>
    </div>
  </section>

  <!-- How We Work -->
  <section class="section bg-gray-50">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-4">
        How We Work
      </h2>
      <p class="text-lg text-gray-500 mb-6">We operate with a simple discipline:</p>
      <ul class="dash-list">
        <li>Coherence before scale</li>
        <li>Trust precedes growth</li>
        <li>Alignment precedes amplification</li>
        <li>Rights precede reach</li>
        <li>Meaning must be stabilized before it can be extended</li>
      </ul>
      <p class="text-lg text-gray-500 leading-relaxed mt-6 max-w-2xl mx-auto">
        Rather than chasing attention, we build the conditions under which institutions can preserve, activate, and compound meaning with confidence.
      </p>
    </div>
  </section>

  <!-- What We Are Not -->
  <section class="section bg-black text-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold mb-8">
        What We Are Not
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3 max-w-3xl mx-auto mb-8">
        {notList.map((item) => (
          <div class="border border-gray-700 rounded-lg px-4 py-3 text-sm text-gray-400">{item}</div>
        ))}
      </div>
      <p class="text-xl lg:text-2xl font-display font-bold">
        Playmakxrs™ is infrastructure for trusted meaning.
      </p>
    </div>
  </section>

  <Footer />
</Layout>
