---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;
const buildPath = (path: string) => `${base}/${path}`.replace(/\/+/g, '/');
const partnerHref = `${buildPath('contact-us')}?interest=partnership`;
---

<Layout
  title="Partnership — Playmakxrs Global™"
  description="A disciplined approach to alignment, trust, and long-term value. We partner with institutions that view narrative as a strategic responsibility."
>
  <Navigation />

  <Hero
    title="Partner With Playmakxrs™"
    subtitle="Alignment, Trust, and Long-Term Value"
    description="We partner with institutions and organizations that view narrative as a strategic responsibility rather than a promotional tool — universities, foundations, athletic departments, alumni communities, museums, cultural organizations, media partners, and values-aligned enterprises seeking durable relevance."
    ctaText="Start a Partnership Conversation"
    ctaHref={partnerHref}
  />

  <!-- Why Partners Engage -->
  <section class="section bg-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-4">
        Why Partners Engage
      </h2>
      <p class="text-xl lg:text-2xl text-gray-700 leading-relaxed mb-6">
        Partners work with Playmakxrs™ when they want to align with stories and moments that carry proven weight. In practical terms, that can support:
      </p>
      <ul class="dash-list">
        <li>Institutional positioning and reputational durability</li>
        <li>Alumni engagement and philanthropic relevance</li>
        <li>Educational reach and student leadership</li>
        <li>Athletics identity and media development</li>
        <li>Sponsor-safe meaning built for long-term trust</li>
      </ul>
    </div>
  </section>

  <!-- Sponsor-Safe Meaning -->
  <section class="section bg-gray-50">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-4">
        Sponsor-Safe Meaning
      </h2>
      <p class="text-xl lg:text-2xl text-gray-700 leading-relaxed mb-4">
        Sponsors are increasingly surrounded by synthetic content, fragmented attention, and audience skepticism. Playmakxrs™ gives sponsors a safer way to align with verified meaning — stories that are rights-governed, institutionally credible, emotionally resonant, and built for long-term trust.
      </p>
      <p class="text-lg text-gray-500 italic">
        Sponsors support the story. They do not own or cheapen it.
      </p>
    </div>
  </section>

  <!-- What Partnership Is — and Is Not -->
  <section class="section bg-white">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-8 text-center">
        What Partnership Is — and Is Not
      </h2>
      <div class="grid md:grid-cols-2 gap-8 max-w-3xl mx-auto">
        <div>
          <h3 class="font-display text-lg font-bold text-black mb-4">Partnership Is</h3>
          <ul class="dash-list-left">
            <li>Values-aligned</li>
            <li>Long-term oriented</li>
            <li>Built on trust</li>
            <li>Structured around responsible stewardship</li>
            <li>Clear about rights and boundaries</li>
          </ul>
        </div>
        <div>
          <h3 class="font-display text-lg font-bold text-black mb-4">Partnership Is Not</h3>
          <ul class="dash-list-left muted">
            <li>Advertising</li>
            <li>Logo placement</li>
            <li>Short-term promotion</li>
            <li>Narrative ownership transfer</li>
            <li>Opportunistic attention extraction</li>
            <li>Synthetic UGC for shallow attention</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-black text-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="text-xl lg:text-2xl opacity-90 mb-6 leading-relaxed">
        We begin with alignment, not pressure.
      </p>
      <Button text="Start a Partnership Conversation" href={partnerHref} variant="primary" />
    </div>
  </section>

  <Footer />
</Layout>
