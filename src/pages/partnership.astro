---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;
const buildPath = (path: string) => `${base}/${path}`.replace(/\/+/g, '/');
---

<Layout
  title="Partnership - Playmakxrs Global™"
  description="A thoughtful approach to cultural partnership built on trust, integrity, and shared values."
>
  <Navigation />

  <Hero
    title="Partner with Playmakxrs"
    subtitle="A Thoughtful Approach to Cultural Partnership"
    description="Partnership is deliberate and principled. We work with universities, academic institutions, foundations, nonprofit fiscal sponsors, athletic programs, and purpose-driven organizations."
  />

  <!-- What Guides Our Work -->
  <section class="section bg-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-4">
        What Guides Our Work
      </h2>
      <p class="text-lg text-gray-500 mb-6">
        Our work is built on non-negotiable beliefs:
      </p>
      <ul class="dash-list">
        <li>Real stories carry cultural weight</li>
        <li>How a story is told matters as much as the story itself</li>
        <li>Integrity and historical accuracy are essential</li>
        <li>Trust is built slowly and protected carefully</li>
      </ul>
    </div>
  </section>

  <!-- How We Partner -->
  <section class="section bg-gray-50">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-4">
        How We Partner
      </h2>
      <p class="text-xl lg:text-2xl text-gray-700 leading-relaxed mb-4">
        Our Partnership & Access Framework provides clear governance, defined access boundaries, protection of historical integrity, and confidence without complexity.
      </p>
      <p class="text-lg text-gray-500 italic">
        Scarcity is intentional. Alignment matters.
      </p>
    </div>
  </section>

  <!-- Who We Work With -->
  <section class="section bg-white">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-8 text-center">
        Who We Work With
      </h2>
      <div class="grid md:grid-cols-2 gap-4 max-w-4xl mx-auto">
        <div class="grid-card">
          <h3 class="font-display text-lg font-bold text-black mb-2">Universities and Academic Institutions</h3>
          <p class="text-gray-600 text-sm">Institutions committed to preserving and teaching authentic American stories.</p>
        </div>
        <div class="grid-card">
          <h3 class="font-display text-lg font-bold text-black mb-2">Athletic Programs and Alumni Communities</h3>
          <p class="text-gray-600 text-sm">Programs that understand the intersection of sport, culture, and legacy.</p>
        </div>
        <div class="grid-card">
          <h3 class="font-display text-lg font-bold text-black mb-2">Foundations and Nonprofit Organizations</h3>
          <p class="text-gray-600 text-sm">Organizations aligned with values-based storytelling and cultural stewardship.</p>
        </div>
        <div class="grid-card">
          <h3 class="font-display text-lg font-bold text-black mb-2">Purpose-Driven Corporations</h3>
          <p class="text-gray-600 text-sm">Companies that lead with values and invest in enduring cultural impact.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- The Bobby Grier Story -->
  <section class="section bg-gray-50">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-4">
        The Bobby Grier Story™
      </h2>
      <p class="text-xl lg:text-2xl text-gray-700 leading-relaxed mb-3">
        At the foundation of every partnership is The Bobby Grier Story™ — a true American legacy built on courage, dignity, and resolve.
      </p>
      <p class="text-lg text-gray-500 italic">
        Partners align with a model, not a moment.
      </p>
    </div>
  </section>

  <!-- What Partnership Is — and Is Not -->
  <section class="section bg-white">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-8 text-center">
        What Partnership Is — and Is Not
      </h2>
      <div class="grid md:grid-cols-2 gap-8 max-w-3xl mx-auto">
        <div>
          <h3 class="font-display text-lg font-bold text-black mb-4">Partnership Is</h3>
          <ul class="dash-list-left">
            <li>Values-based</li>
            <li>Long-term oriented</li>
            <li>Built on trust</li>
          </ul>
        </div>
        <div>
          <h3 class="font-display text-lg font-bold text-black mb-4">Partnership Is Not</h3>
          <ul class="dash-list-left muted">
            <li>Advertising</li>
            <li>Logo placement</li>
            <li>Short-term promotion</li>
            <li>Narrative ownership</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-black text-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="text-xl lg:text-2xl opacity-90 mb-6 leading-relaxed">
        No urgency. No pressure. Only alignment.
      </p>
      <Button text="Start a Conversation" href={buildPath('contact-us')} variant="primary" />
    </div>
  </section>

  <Footer />
</Layout>
