---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';
import MediaLogos from '../components/MediaLogos.astro';

const base = import.meta.env.BASE_URL;
const buildPath = (path: string) => {
  const normalized = `${base}/${path}`.replace(/\/+/g, '/');
  return normalized;
};
---

<Layout
  title="Playmakxrs Global™ - Preserving Stories That Hold Us Together"
  description="A narrative infrastructure platform dedicated to preserving and stewarding America's most consequential stories"
>
  <Navigation />

  <Hero
    title="PLAYMAKXRS™ | PLAYMAKXRS GLOBAL"
    subtitle="Preserving Stories That Hold Us Together"
    description="Playmakxrs™ and Playmakxrs Global™ are a narrative infrastructure platform dedicated to preserving and stewarding America's most consequential stories — stories rooted in courage, integrity, and historical truth."
    ctaText="Discover the Story"
    ctaHref={buildPath('the-book')}
  />

  <!-- What We Believe -->
  <section class="bg-white py-20">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <h2 class="font-display text-4xl md:text-5xl font-bold text-black mb-6">
        What We Believe
      </h2>
      <p class="text-xl text-gray-700 max-w-3xl mx-auto leading-relaxed mb-8">
        Not all stories are meant to be optimized for attention. Some are meant to be protected, carried forward, and told with restraint.
      </p>
      <div class="max-w-2xl mx-auto text-left">
        <ul class="space-y-4 text-lg text-gray-700">
          <li class="flex items-start gap-3">
            <span class="text-primary mt-1 font-bold">—</span>
            <span>Reduce division rather than inflame it</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-primary mt-1 font-bold">—</span>
            <span>Create shared understanding rather than spectacle</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-primary mt-1 font-bold">—</span>
            <span>Unite people around values that outlast trends</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- What We Do -->
  <section class="bg-gray-50 py-20">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display text-4xl md:text-5xl font-bold text-black mb-6 text-center">
          What We Do
        </h2>
        <p class="text-xl text-gray-700 leading-relaxed mb-8 text-center">
          Playmakxrs™ exists to identify, interpret, and steward stories that already carry meaning — through books, limited-run series, archival storytelling, national moments, and institutional partnerships.
        </p>
        <div class="space-y-4 text-lg text-gray-700">
          <p class="font-display font-semibold text-black mb-4">Our work is grounded in:</p>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <span class="text-primary mt-1 font-bold">—</span>
              <span>Historic moments rooted in documented truth and lived experience</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-primary mt-1 font-bold">—</span>
              <span>Institutional alignment built on trust, credibility, and shared values</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-primary mt-1 font-bold">—</span>
              <span>Cultural infrastructure designed for endurance, not cycles</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Who We Work With -->
  <section class="bg-black text-white py-20">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-4xl md:text-5xl font-bold mb-6">
        Who We Work With
      </h2>
      <p class="text-xl opacity-90 mb-8 leading-relaxed">
        We partner selectively with organizations that value integrity and historical accuracy, long-term cultural relevance, educational and community impact, and values-based leadership.
      </p>
      <p class="text-lg opacity-80 italic mb-8">
        Partnership with Playmakxrs™ is not transactional. It is participatory.
      </p>
      <Button text="Learn About Partnership" href={buildPath('partnership')} variant="primary" />
    </div>
  </section>

  <!-- Media Logos -->
  <MediaLogos />

  <Footer />
</Layout>
