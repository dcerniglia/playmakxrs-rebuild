---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';
import MediaLogos from '../components/MediaLogos.astro';

const base = import.meta.env.BASE_URL;
const buildPath = (path: string) => {
  const normalized = `${base}/${path}`.replace(/\/+/g, '/');
  return normalized;
};
---

<Layout
  title="Playmakxrs Global™ - Preserving Stories That Hold Us Together"
  description="A narrative infrastructure platform dedicated to preserving and stewarding America's most consequential stories"
>
  <Navigation />

  <Hero
    title="PLAYMAKXRS™"
    subtitle="Preserving Stories That Hold Us Together"
    description="Playmakxrs™ and Playmakxrs Global™ are a narrative infrastructure platform dedicated to preserving and stewarding America's most consequential stories — stories rooted in courage, integrity, and historical truth."
    ctaText="Discover the Story"
    ctaHref={buildPath('the-book')}
  />

  <!-- What We Believe -->
  <section class="section bg-white">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-4">
        What We Believe
      </h2>
      <p class="text-xl lg:text-2xl text-gray-700 max-w-3xl mx-auto leading-relaxed mb-6">
        Not all stories are meant to be optimized for attention. Some are meant to be protected, carried forward, and told with restraint.
      </p>
      <ul class="dash-list">
        <li>Reduce division rather than inflame it</li>
        <li>Create shared understanding rather than spectacle</li>
        <li>Unite people around values that outlast trends</li>
      </ul>
    </div>
  </section>

  <!-- What We Do -->
  <section class="section bg-gray-50">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-4">
        What We Do
      </h2>
      <p class="text-xl lg:text-2xl text-gray-700 leading-relaxed mb-6">
        Playmakxrs™ exists to identify, interpret, and steward stories that already carry meaning — through books, limited-run series, archival storytelling, national moments, and institutional partnerships.
      </p>
      <p class="font-display font-semibold text-black mb-4 text-sm uppercase tracking-wider">Our work is grounded in</p>
      <ul class="dash-list">
        <li>Historic moments rooted in documented truth and lived experience</li>
        <li>Institutional alignment built on trust, credibility, and shared values</li>
        <li>Cultural infrastructure designed for endurance, not cycles</li>
      </ul>
    </div>
  </section>

  <!-- Who We Work With -->
  <section class="section bg-black text-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold mb-4">
        Who We Work With
      </h2>
      <p class="text-xl lg:text-2xl opacity-90 mb-6 leading-relaxed">
        We partner selectively with organizations that value integrity and historical accuracy, long-term cultural relevance, educational and community impact, and values-based leadership.
      </p>
      <p class="text-xl lg:text-2xl opacity-70 italic mb-6">
        Partnership with Playmakxrs™ is not transactional. It is participatory.
      </p>
      <Button text="Learn About Partnership" href={buildPath('partnership')} variant="primary" />
    </div>
  </section>

  <MediaLogos />

  <Footer />
</Layout>
