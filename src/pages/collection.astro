---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';

const shopifyUrl = 'https://playmakxrs.myshopify.com';
---

<Layout
  title="The Collection — Playmakxrs Global™"
  description="The Playmakxrs™ Collection offers a quiet way to carry the legacy forward — durable markers of participation, not promotion."
>
  <Navigation />

  <Hero
    title="The Collection"
    subtitle="Participation, Not Promotion"
    description="The Playmakxrs™ Collection offers a quiet way for readers, supporters, and participants to carry the legacy forward. Each item is designed with restraint and reflects the same standards that guide the platform itself."
    ctaText="Explore the Collection"
    ctaHref={shopifyUrl}
  />

  <!-- Why It Exists -->
  <section class="section bg-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-4">
        Why It Exists
      </h2>
      <p class="text-xl lg:text-2xl text-gray-700 leading-relaxed mb-3">
        Some people engage through reading, dialogue, and institutional participation. Others want a physical way to remain connected to a legacy that matters to them. The collection provides that option without spectacle or urgency.
      </p>
      <p class="text-lg text-gray-500 leading-relaxed">
        These are not promotional products built for novelty or volume. They are durable markers of participation in a story and a standard of stewardship.
      </p>
    </div>
  </section>

  <!-- What Guides the Collection -->
  <section class="section bg-gray-50">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-8 text-center">
        What Guides the Collection
      </h2>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="value-pill">Purpose over volume</div>
        <div class="value-pill">Simplicity over statement</div>
        <div class="value-pill">Quality over novelty</div>
        <div class="value-pill">Meaning over messaging</div>
      </div>
    </div>
  </section>

  <!-- A Note on Proceeds -->
  <section class="section bg-white">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-black mb-4">
        A Note on Proceeds
      </h2>
      <p class="text-xl lg:text-2xl text-gray-700 leading-relaxed">
        Proceeds support the continued stewardship of authentic legacy stories through Playmakxrs™ and Playmakxrs Global™. This is participation, not promotion.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-black text-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold mb-4">
        Explore the Collection
      </h2>
      <p class="text-xl lg:text-2xl opacity-90 mb-6 leading-relaxed">
        No urgency. No pressure. Only intention.
      </p>
      <Button text="View the Collection" href={shopifyUrl} variant="primary" />
    </div>
  </section>

  <Footer />
</Layout>
