---
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A narrative infrastructure platform dedicated to preserving and stewarding America\'s most consequential stories' } = Astro.props;
const base = import.meta.env.BASE_URL;
const buildPath = (path: string) => `${base}/${path}`.replace(/\/+/g, '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={buildPath('favicon.svg')} />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet" />

    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body class="font-sans antialiased">
    <slot />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  * {
    margin: 0;
    padding: 0;
  }

  /* Centered dash list used across content pages */
  .dash-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .dash-list li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    text-align: left;
    max-width: 36rem;
    width: 100%;
    font-size: 1.125rem;
    line-height: 1.75rem;
    color: #374151; /* gray-700 */
  }

  .dash-list li::before {
    content: '—';
    color: #DC2626; /* primary */
    font-weight: 700;
    flex-shrink: 0;
  }

  /* Left-aligned variant for grid columns */
  .dash-list-left {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .dash-list-left li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 1.125rem;
    line-height: 1.75rem;
    color: #374151;
  }

  .dash-list-left li::before {
    content: '—';
    color: #DC2626;
    font-weight: 700;
    flex-shrink: 0;
  }

  .dash-list-left.muted li::before {
    color: #9CA3AF; /* gray-400 */
  }
</style>
