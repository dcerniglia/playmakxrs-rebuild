---
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="max-w-3xl mx-auto divide-y divide-gray-200 border-y border-gray-200">
  {items.map((item) => (
    <details class="faq-item group">
      <summary class="flex items-center justify-between gap-4 cursor-pointer py-5 list-none">
        <span class="font-display font-semibold text-lg text-black">{item.q}</span>
        <svg
          class="w-5 h-5 flex-shrink-0 text-primary transition-transform duration-200 group-open:rotate-45"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
      </summary>
      <p class="text-gray-600 leading-relaxed pb-5 -mt-1">{item.a}</p>
    </details>
  ))}
</div>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
</style>
