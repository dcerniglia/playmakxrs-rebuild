---
// Categorized institutional intake form, pre-configured for Netlify Forms.
// Site-wide CTAs can deep-link with ?interest=<slug> (and optionally ?as=<slug>)
// to preselect the dropdowns — see the prefill script at the bottom.

const reachingOptions = [
  'University / Academic Leader',
  'Athletic Department / NIL',
  'Advancement / Alumni Relations',
  'Foundation / Nonprofit',
  'Corporate Partner / Sponsor',
  'Media / Documentary / Series',
  'Museum / Archive / Cultural Institution',
  'Government / Economic Development',
  'Athlete / Family / Legacy Steward',
  'General Inquiry',
];

const interestOptions = [
  'Institutional Narrative Infrastructure™',
  'For Institutions / Customer Inquiry',
  '90–120 Day INI™ Pilot',
  'Moment-to-Meaning Brief™',
  'Narrative Capital™ Map',
  'Sponsor Coherence Map™',
  'Digital Exhibit / Archive Activation',
  'Media / Documentary / Series',
  'Leadership Programming',
  'Sponsorship / Corporate Partnership',
  'Book / Speaking / Event',
  'General Inquiry',
];

const qualifyingQuestions = [
  { name: 'q-story', label: 'What story, institution, or opportunity are you exploring?' },
  { name: 'q-timing', label: 'Is there an event, deadline, anniversary, or decision window?' },
  { name: 'q-rights', label: 'Are rights or approvals already clear?' },
  { name: 'q-partners', label: 'Are sponsors or media partners involved?' },
  { name: 'q-outcome', label: 'What outcome would make this conversation useful?' },
];

const inputClass = 'w-full px-4 py-3 border-2 border-gray-300 rounded-md focus:border-primary focus:outline-none transition-colors';
---

<section id="contact" class="bg-white py-16 lg:py-24">
  <div class="max-w-3xl mx-auto px-6">
    <form
      name="inquiry"
      method="POST"
      data-netlify="true"
      data-netlify-honeypot="bot-field"
      class="space-y-6"
    >
      <input type="hidden" name="form-name" value="inquiry" />
      <p class="hidden">
        <label>Don't fill this out if you're human: <input name="bot-field" /></label>
      </p>

      <!-- Categorization -->
      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <label for="reaching-as" class="block text-sm font-semibold text-gray-700 mb-2">I am reaching out as *</label>
          <select id="reaching-as" name="I am reaching out as" required class={inputClass}>
            <option value="" disabled selected>Select one</option>
            {reachingOptions.map((opt) => <option value={opt}>{opt}</option>)}
          </select>
        </div>
        <div>
          <label for="interested-in" class="block text-sm font-semibold text-gray-700 mb-2">I am interested in *</label>
          <select id="interested-in" name="I am interested in" required class={inputClass}>
            <option value="" disabled selected>Select one</option>
            {interestOptions.map((opt) => <option value={opt}>{opt}</option>)}
          </select>
        </div>
      </div>

      <!-- Basic fields -->
      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <label for="first-name" class="block text-sm font-semibold text-gray-700 mb-2">First Name *</label>
          <input type="text" id="first-name" name="First Name" required class={inputClass} />
        </div>
        <div>
          <label for="last-name" class="block text-sm font-semibold text-gray-700 mb-2">Last Name *</label>
          <input type="text" id="last-name" name="Last Name" required class={inputClass} />
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <label for="organization" class="block text-sm font-semibold text-gray-700 mb-2">Organization</label>
          <input type="text" id="organization" name="Organization" class={inputClass} />
        </div>
        <div>
          <label for="role" class="block text-sm font-semibold text-gray-700 mb-2">Role / Title</label>
          <input type="text" id="role" name="Role / Title" class={inputClass} />
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <label for="contact-info" class="block text-sm font-semibold text-gray-700 mb-2">Email or Phone *</label>
          <input type="text" id="contact-info" name="Email or Phone" required class={inputClass} />
        </div>
        <div>
          <label for="website" class="block text-sm font-semibold text-gray-700 mb-2">Website</label>
          <input type="text" id="website" name="Website" class={inputClass} />
        </div>
      </div>

      <div>
        <label for="message" class="block text-sm font-semibold text-gray-700 mb-2">Message *</label>
        <textarea id="message" name="Message" required rows="4" class={`${inputClass} resize-none`}></textarea>
      </div>

      <!-- Optional qualifying questions -->
      <fieldset class="border-t border-gray-200 pt-6">
        <legend class="font-display font-bold text-black mb-1">A Few Optional Questions</legend>
        <p class="text-sm text-gray-500 mb-4">These help us prepare — none are required.</p>
        <div class="space-y-4">
          {qualifyingQuestions.map((q) => (
            <div>
              <label for={q.name} class="block text-sm font-medium text-gray-600 mb-2">{q.label}</label>
              <textarea id={q.name} name={q.label} rows="2" class={`${inputClass} resize-none`}></textarea>
            </div>
          ))}
        </div>
      </fieldset>

      <p class="text-xs text-gray-400 leading-relaxed">
        Submitting this form does not create a partnership, license, rights agreement, or obligation by either party. Playmakxrs™ reviews inquiries for fit, alignment, rights considerations, and capacity before moving forward.
      </p>

      <button
        type="submit"
        class="w-full bg-primary hover:bg-primary-dark text-white font-display font-bold px-8 py-4 rounded-md text-lg uppercase tracking-wide transition-all duration-300 hover:scale-[1.02]"
      >
        Submit Inquiry
      </button>
    </form>
  </div>
</section>

<script>
  // Preselect the dropdowns from ?interest= / ?as= so site-wide CTAs carry intent.
  function prefillInquiry() {
    const params = new URLSearchParams(window.location.search);
    const interestMap: Record<string, string> = {
      'ini': 'Institutional Narrative Infrastructure™',
      'for-institutions': 'For Institutions / Customer Inquiry',
      'pilot': '90–120 Day INI™ Pilot',
      'moment-to-meaning': 'Moment-to-Meaning Brief™',
      'narrative-capital-map': 'Narrative Capital™ Map',
      'sponsor-coherence': 'Sponsor Coherence Map™',
      'digital-exhibit': 'Digital Exhibit / Archive Activation',
      'media': 'Media / Documentary / Series',
      'leadership': 'Leadership Programming',
      'partnership': 'Sponsorship / Corporate Partnership',
      'book-event': 'Book / Speaking / Event',
      'general': 'General Inquiry',
    };
    const asMap: Record<string, string> = {
      'university': 'University / Academic Leader',
      'athletics-nil': 'Athletic Department / NIL',
      'advancement': 'Advancement / Alumni Relations',
      'foundation': 'Foundation / Nonprofit',
      'corporate': 'Corporate Partner / Sponsor',
      'media': 'Media / Documentary / Series',
      'museum': 'Museum / Archive / Cultural Institution',
      'government': 'Government / Economic Development',
      'athlete-family': 'Athlete / Family / Legacy Steward',
      'general': 'General Inquiry',
    };

    const interest = params.get('interest');
    const as = params.get('as');
    const interestEl = document.getElementById('interested-in') as HTMLSelectElement | null;
    const asEl = document.getElementById('reaching-as') as HTMLSelectElement | null;

    if (interest && interestEl && interestMap[interest]) {
      interestEl.value = interestMap[interest];
    }
    if (as && asEl && asMap[as]) {
      asEl.value = asMap[as];
    }
  }

  prefillInquiry();
  document.addEventListener('astro:page-load', prefillInquiry);
</script>
