---
const base = import.meta.env.BASE_URL;
const buildPath = (path: string) => `${base}/${path}`.replace(/\/+/g, '/');

const logos = [
  {
    name: 'History',
    src: buildPath('logos/history.svg'),
    href: 'https://www.history.com/articles/bobby-grier-college-football-color-barrier-sugar-bowl',
  },
  {
    name: 'ESPN',
    src: buildPath('logos/espn.svg'),
    href: 'https://www.espn.com/college-football/story/_/id/26027623/the-south-stands-armageddon-breaking-sugar-bowl-color-barrier',
  },
  {
    name: 'Georgia Tech',
    src: buildPath('logos/georgia-tech.png'),
    href: 'https://www.gtalumni.org/news/2024/the-big-moment.html',
  },
  {
    name: 'Fox',
    src: buildPath('logos/fox.svg'),
    href: 'https://www.youtube.com/watch?v=rqKf4Es0uOU',
  },
  {
    name: 'Amazon',
    src: buildPath('logos/amazon.svg'),
    href: 'https://a.co/d/aXjebcH',
  },
  {
    name: 'Barnes & Noble',
    src: buildPath('logos/barnes-noble.svg'),
    href: 'https://www.barnesandnoble.com/w/no-grier-no-game-rob-grier/1148515839',
  },
  {
    name: 'ABC',
    src: buildPath('logos/abc.svg'),
    href: 'https://wgno.com/hidden-history/sweet-integration-the-story-of-bobby-grier-and-the-1956-sugar-bowl/',
  },
  {
    name: 'KDKA',
    src: buildPath('logos/kdka.svg'),
    href: 'https://www.cbsnews.com/pittsburgh/news/former-pitt-football-player-and-first-black-player-to-play-in-the-sugar-bowl-bobby-grier-dies-at-91/',
  },
  {
    name: 'Pitt Athletics',
    src: buildPath('logos/pitt.svg'),
    href: 'https://pittsburghpanthers.com/honors/pitt-athletics-hall-of-fame/bobby-grier/44',
  },
];
---

<section class="bg-gray-50 py-16 border-t border-gray-200 overflow-hidden">
  <div class="max-w-5xl mx-auto px-6">
    <p class="text-center text-base uppercase tracking-widest text-gray-500 mb-12 font-semibold">
      As Featured In
    </p>
    <div class="carousel-track">
      <div class="carousel-inner">
        {logos.map((logo) => (
          <a
            href={logo.href}
            target="_blank"
            rel="noopener noreferrer"
            class="carousel-item"
            aria-label={`Featured in ${logo.name}`}
          >
            <img
              src={logo.src}
              alt={logo.name}
              class="h-8 md:h-12 w-auto max-w-[140px] md:max-w-[180px] object-contain"
            />
          </a>
        ))}
        {/* Duplicate set for seamless loop */}
        {logos.map((logo) => (
          <a
            href={logo.href}
            target="_blank"
            rel="noopener noreferrer"
            class="carousel-item"
            aria-label={`Featured in ${logo.name}`}
            aria-hidden="true"
          >
            <img
              src={logo.src}
              alt=""
              class="h-8 md:h-12 w-auto max-w-[140px] md:max-w-[180px] object-contain"
            />
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .carousel-track {
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .carousel-inner {
    display: flex;
    align-items: center;
    gap: 3.5rem;
    width: max-content;
    animation: scroll 60s linear infinite;
  }

  .carousel-inner:hover {
    animation-play-state: paused;
  }

  .carousel-item {
    flex-shrink: 0;
    opacity: 1;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .carousel-item:hover {
    opacity: 1;
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (min-width: 768px) {
    .carousel-item {
      opacity: 0.85;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-inner {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
    }
    .carousel-item[aria-hidden="true"] {
      display: none;
    }
  }
</style>

<script>
  function restartCarousel() {
    const inner = document.querySelector('.carousel-inner') as HTMLElement;
    if (!inner) return;
    inner.style.animation = 'none';
    inner.offsetHeight; // force reflow
    inner.style.animation = '';
  }
  restartCarousel();
  document.addEventListener('astro:page-load', restartCarousel);
</script>
