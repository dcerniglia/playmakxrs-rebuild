---
const base = import.meta.env.BASE_URL;
const buildPath = (path: string) => `${base}/${path}`.replace(/\/+/g, '/');
const currentPath = Astro.url.pathname;
const navItems = [
  { name: 'About', href: buildPath('about-us') },
  { name: 'For Institutions', href: buildPath('for-institutions') },
  { name: 'Pilot', href: buildPath('pilot') },
  { name: 'Partnership', href: buildPath('partnership') },
  { name: 'The Book', href: buildPath('the-book') },
  { name: 'Collection', href: buildPath('collection') },
];
---

<nav class="sticky top-0 z-50 bg-white shadow-sm">
  <div class="max-w-7xl mx-auto px-6 py-4">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="block transition-all duration-200 hover:opacity-80">
        <img
          src={buildPath('pg-logo-light.jpg')}
          alt="Playmakxrs Global"
          class="h-14 md:h-16 w-auto"
        />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center space-x-4 xl:space-x-6">
        {navItems.map(item => (
          <a
            href={item.href}
            class={`font-display font-semibold text-sm transition-all duration-200 ${
              currentPath === item.href
                ? 'text-primary border-b-2 border-primary'
                : 'text-black hover:text-primary'
            }`}
          >
            {item.name}
          </a>
        ))}
        <a
          href={buildPath('contact-us')}
          class="bg-primary text-white px-5 py-2 rounded-md font-display font-bold text-sm hover:bg-primary-dark transition-all duration-200 transform hover:scale-105"
        >
          Contact Us
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="lg:hidden text-black focus:outline-none"
        aria-label="Toggle mobile menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden lg:hidden mt-4 pb-4">
      <a
        href={buildPath('')}
        class={`block py-2 font-display font-semibold transition-colors ${
          currentPath === buildPath('') ? 'text-primary' : 'text-black hover:text-primary'
        }`}
      >
        Home
      </a>
      {navItems.map(item => (
        <a
          href={item.href}
          class={`block py-2 font-display font-semibold transition-colors ${
            currentPath === item.href
              ? 'text-primary'
              : 'text-black hover:text-primary'
          }`}
        >
          {item.name}
        </a>
      ))}
      <a
        href={buildPath('contact-us')}
        class="block mt-4 bg-primary text-white px-6 py-2 rounded-md font-display font-bold text-center hover:bg-primary-dark transition-colors"
      >
        Contact Us
      </a>
    </div>
  </div>
</nav>

<script>
  function setupMobileMenu() {
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');

    if (button && menu) {
      const newButton = button.cloneNode(true);
      button.parentNode?.replaceChild(newButton, button);

      newButton.addEventListener('click', () => {
        menu.classList.toggle('hidden');
      });
    }
  }

  setupMobileMenu();

  document.addEventListener('astro:page-load', () => {
    setupMobileMenu();
    const menu = document.getElementById('mobile-menu');
    menu?.classList.add('hidden');
  });
</script>
